# Copernicus Open Access Hub credentials
# Register at: https://dataspace.copernicus.eu/
COPERNICUS_USER=your_username_or_email
COPERNICUS_PASSWORD=your_password

# Optional: alternative DHUS endpoint (defaults to Copernicus Dataspace)
# SENTINEL_API_URL=https://apihub.copernicus.eu/apihub

# Global Fishing Watch API token (free at https://globalfishingwatch.org/our-apis/)
# Used for AIS dark vessel matching in src/match/ais_match.py
GFW_API_TOKEN=your_token_here
